# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Ссылка на образовательную платформу (можно поменять командой /setplatform)
PLATFORM_URL=

# Ссылка-приглашение в группу, в которую нужно вступить перед доступом к платформе (можно поменять командой /setchannel).
# Бота нужно добавить админом в эту группу, иначе он не сможет проверить вступление.
CHANNEL_URL=

# Битрикс24 (необязательно): входящий вебхук с правами CRM и ID источника лида (crm.status.list, ENTITY_ID=SOURCE)
BITRIX_WEBHOOK_URL=
BITRIX_SOURCE_ID=OTHER
# Через сколько минут без ответа человек считается бросившим опрос (можно поменять командой /setleaddelay)
LEAD_DELAY_MIN=60

# Через сколько минут напоминать, если пользователь не ответил на вопрос (можно поменять командой /setreminddelay)
NO_ANSWER_DELAY_MIN=30

# Время начала мастер-классов (ISO 8601 с часовым поясом Праги) и длительность в минутах
MED_STARTS_AT=2026-11-23T14:00:00+01:00
TECH_STARTS_AT=2026-11-26T16:00:00+01:00
MK_DURATION_MIN=120

# Путь к файлу базы SQLite
DB_PATH=data/bot.db

# Google Sheets (необязательно): ID таблицы из URL, имя листа и JSON-ключ сервисного аккаунта
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Регистрации
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
