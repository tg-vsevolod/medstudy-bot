# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Ссылка на образовательную платформу (можно поменять командой /setplatform)
PLATFORM_URL=

# Ссылка-приглашение в группу, в которую нужно вступить перед доступом к платформе.
# Бота нужно добавить админом в эту группу, иначе он не сможет проверить вступление.
CHANNEL_URL=

# Через сколько минут напоминать, если пользователь не ответил на вопрос
NO_ANSWER_DELAY_MIN=30

# Время начала мастер-классов (ISO 8601 с часовым поясом Праги) и длительность в минутах
MED_STARTS_AT=2026-11-23T14:00:00+01:00
TECH_STARTS_AT=2026-11-26T16:00:00+01:00
MK_DURATION_MIN=120

# Путь к файлу базы SQLite
DB_PATH=data/bot.db

# Google Sheets (необязательно): ID таблицы из URL, имя листа и JSON-ключ сервисного аккаунта
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Регистрации
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
